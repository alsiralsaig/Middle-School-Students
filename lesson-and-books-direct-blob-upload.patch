+                {uploading ? <><Loader2 className="h-4 w-4 animate-spin" /> جارٍ الرفع {Math.round(uploadProgress)}٪</> : <><Upload className="h-4 w-4" /> رفع وحفظ</>}
+              </button>
+            </footer>
+          </form>
+        </section>
+      </div>}
     </div>
   );
 };
