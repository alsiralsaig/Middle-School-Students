// مخطط قاعدة البيانات — منصة الطالب السوداني الذكية
// PostgreSQL — تُقرأ من المتغيّر DATABASE_URL (Neon للإنتاج)

generator client {
  provider      = "prisma-client-js"
  // بيئات التنفيذ: الخادم المحلي، وVercel ‏(Amazon Linux 2023)، وDebian
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ============================ المستخدمون ============================ */

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  /**
   * الرقم السري كما كتبه الطالب (أو صفّره المدير) — نصّ صريح.
   *
   * لماذا: طلاب المرحلة المتوسطة صغار وينسون أرقامهم، وكان المدير يضطر
   * لإصدار رمز جديد وإرساله. الآن يرى المدير الرقم الذي اختاره الطالب نفسه
   * ويبلّغه ليه أو لولي أمره مباشرة.
   * لا يُرسل لأي واجهة إلا لواجهة الإدارة (`role = admin`)، ولا يُحفظ لحساب
   * إدارة إطلاقاً.
   */
  plainPin     String?
  role         String   @default("student") // student | admin
  grade        String?
  school       String?
  state        String?
  avatar       String?
  createdAt    DateTime @default(now())

  progress    LessonProgress[]
  ratings     LessonRating[]
  sessions    StudySession[]
  events      PlannerEvent[]
  attempts    ExamAttempt[]
  notifications Notification[]
  accessCodes AccessCode[]
  passwordResets PasswordResetRequest[]
  mediaAssets MediaAsset[]
}

/* ============================ المنهج ============================ */

model Subject {
  id            String     @id
  name          String
  nameEn        String
  code          String     @unique
  category      String
  description   String
  curriculumRef String?
  unitsCount    Int        @default(0)
  lessonsCount  Int        @default(0)
  // مصدر رسمي لهيكل المادة (JSON): {book, publisher, pages, url, confidence, note...}
  official      String?
  // الهيكل الرسمي الكامل (JSON): [{unitNumber, title, startPage, endPage, lessons[]}]
  // يختلف عن `units` التي تمثّل **ما ألّفناه نحن** في التطبيق.
  syllabus      String?
  // تحذير اختلاف الصف (مثل: الكتاب المعتمد للصف الثاني لا الثالث)
  gradeWarning  String?
  status        String     @default("sample") // sample | verified

  units     Unit[]
  lessons   Lesson[]
  resources Resource[]
  exams     Exam[]
}

model Unit {
  id          String  @id
  subjectId   String
  unitNumber  Int
  title       String
  description String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id                String @id
  subjectId         String
  unitId            String
  lessonNumber      Int
  title             String
  durationMinutes   Int    @default(30)
  summary           String
  // حقول JSON مخزّنة كنص (SQLite لا يدعم مصفوفات)
  learningObjectives String @default("[]")
  sections           String @default("[]")
  keyRules           String @default("[]")
  attachments        String @default("[]")
  faq                String @default("[]")
  examTips           String @default("[]")
  status             String @default("sample") // sample | verified

  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit     Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  progress  LessonProgress[]
  ratings   LessonRating[]
  questions ExamQuestion[]

  @@unique([subjectId, unitId, lessonNumber])
}

/* ============================ تقدّم الطالب ============================ */

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean  @default(false)
  bookmarked   Boolean  @default(false)
  secondsSpent Int      @default(0)
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonRating {
  id        String   @id @default(cuid())
  userId    String?
  lessonId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD
  minutes   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlannerEvent {
  id          String  @id @default(cuid())
  userId      String
  title       String
  type        String // exam | trial_exam | review | deadline | live_class | reminder
  date        String // YYYY-MM-DD
  time        String // HH:MM
  subjectName String
  description String?
  groupId     String?
  weekday     Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("system")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* ============================ المكتبة ============================ */

model Resource {
  id                   String  @id
  subjectId            String?
  title                String
  category             String
  fileType             String
  fileSize             String
  pageCount            Int     @default(0)
  author               String?
  publishYear          String?
  isVerifiedCurriculum Boolean @default(false)
  downloadCount        Int     @default(0)
  description          String
  previewSummary       String  @default("[]")
  filePath             String? // مسار الملف بعد ربط التخزين
  status               String  @default("sample")
  body                 String? // النص الكامل للمذكرة/الملخص — يُقرأ داخل التطبيق بلا تنزيل
  externalUrl          String? // للاختبارات التفاعلية: رابط يُفتح في المتصفح
  sourceUrl            String? // صفحة المصدر الأصلية على المنصة
  grade                String  @default("third-middle")
  sortOrder            Int     @default(0)
  isPublished          Boolean @default(true) // الإدارة تُقرّر ما يظهر في تطبيق الطالب
  publishedAt          DateTime?

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

/* ============================ الاختبارات ============================ */

model Exam {
  id              String   @id @default(cuid())
  subjectId       String
  title           String
  durationMinutes Int      @default(30)
  status          String   @default("sample")
  createdAt       DateTime @default(now())

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id           String  @id @default(cuid())
  examId       String
  lessonId     String?
  question     String
  options      String // JSON
  correctIndex Int
  explanation  String?

  exam   Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model ExamAttempt {
  id         String    @id @default(cuid())
  examId     String
  userId     String
  score      Int       @default(0)
  total      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]
}

/// ملفات وروابط مشتركة للمحتوى؛ لا نخزّن روابط القراءة الخاصة في قاعدة البيانات.
model MediaAsset {
  id           String   @id
  kind         String
  access       String   @default("public")
  ownerType    String
  ownerId      String
  userId       String?
  subjectId    String?
  category     String?
  title        String
  description  String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  pathname     String?  @unique
  url          String?
  externalUrl  String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId, access])
  @@index([userId, access])
}

model ExamAnswer {
  id          String @id @default(cuid())
  attemptId   String
  questionId  String
  chosenIndex Int
  correct     Boolean

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

/// رمز دخول تُصدره الإدارة ليستخدمه الطالب **مرة واحدة** عند إنشاء حسابه.
///
/// لماذا موجود: تطبيق الطالب مخصّص للطلاب، والإدارة هي من يأذن بالدخول.
/// الرمز قد يكون موجّهاً لطالب بعينه (عبر `phone`) أو حراً لأول طالب يستخدمه.
/// طلب استعادة كلمة مرور — بلا بريد صادر، فالإدارة تُصدر كلمة مرور مؤقتة
model PasswordResetRequest {
  id               String   @id @default(cuid())
  userId           String
  identifier       String
  status           String   @default("pending") // pending | issued | dismissed
  tempPasswordHint String?
  createdAt        DateTime @default(now())
  resolvedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id          String    @id @default(cuid())
  /// ٦ خانات من أبجدية لا تُلتبس فيها الأرقام بالحروف
  code        String    @unique
  studentName String?
  /// إن حُدِّد، فلا يقبل الرمز إلا من يسجّل بهذا الهاتف
  phone       String?
  grade       String?
  school      String?
  /// active | used | revoked
  status      String    @default("active")
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  usedById String?
  usedBy   User?   @relation(fields: [usedById], references: [id])
}

/// رسالة في غرفة مذاكرة جماعية — مشتركة بين كل الطلاب فعلياً (لا محاكاة).
model StudyMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  name      String
  avatar    String?
  state     String?
  body      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}
