# ============================================================
#  نسخ هذا الملف إلى .env ثم عدّل القيم
#  cp .env.example .env
# ============================================================

# قاعدة البيانات — SQLite للتطوير (لا يحتاج أي تثبيت)
DATABASE_URL="file:./dev.db"

# للإنتاج مع PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/sudan_platform?schema=public"

PORT=5000

# سرّ توقيع جلسات الدخول (JWT) — غيّره بقيمة عشوائية طويلة في الإنتاج
JWT_SECRET="غير-هذا-السر-بقيمة-عشوائية-طويلة"

# بيئة التشغيل: development | production
NODE_ENV=development

# رابط واجهة الطالب (يُستخدم في CORS والكوكيز)
CLIENT_ORIGIN="http://localhost:3000"

# ------------------- الذكاء الاصطناعي (اختياري) -------------------
# المفتاح يبقى على الخادم فقط ولا يُرسل للمتصفح أبداً.
# بدونه تعمل نقاط /api/ai/* بردّ تعليمي بديل ولا يتعطّل التطبيق.
GEMINI_API_KEY=""

# تحديد الطلبات: عدد الطلبات لكل مستخدم في النافذة الزمنية، وسقف يومي عام
AI_RATE_MAX=20
AI_DAILY_CAP=2000
